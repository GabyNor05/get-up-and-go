{
  "expo": {
    "name": "Get Up & Go",
    "slug": "Your new way to get out",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "../../packages/shared-ui/assets/logos/lightBgLogo.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF8F0",
        "foregroundImage": "./assets/apple-touch-icon.png"
      },
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF8F0",
        "foregroundImage": "./assets/favicon-96x96.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.Yournewwaytogetout"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon-96x96.png"
    },
    "plugins": [
      "expo-router",
      [
        
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
