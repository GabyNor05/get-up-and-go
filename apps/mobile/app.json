{
  "expo": {
    "name": "Get Up & Go",
    "slug": "get-up-and-go",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "splash": {
      "image": "./assets/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F0DD",
      "dark": {
        "image": "./assets/splash-logo.png",
        "backgroundColor": "#1A1A1A"
      }
    },
    "scheme": "getupandgo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gabynorris.getupandgo",
      "icon": "./assets/app-icon.png"
    },
    "android": {
      "package": "com.gabynorris.getupandgo",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#F4F0DD"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "icon": "./assets/app-icon.png"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon-96x96.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F4F0DD",
          "dark": {
            "image": "./assets/splash-logo.png",
            "backgroundColor": "#1A1A1A"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Get Up & Go uses your camera to scan venue QR codes when you check in to a Happening.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Get Up & Go uses your location to show Happenings near you."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#5B4C9E"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "41bcd6a2-19d6-484f-bfea-ef67dd64e6a5"
      }
    },
    "owner": "gabynor"
  }
}
